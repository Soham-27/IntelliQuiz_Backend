  // This is your Prisma schema file,
  // learn more about it in the docs: https://pris.ly/d/prisma-schema

  generator client {
    provider = "prisma-client-js"
  }

  datasource db {
    provider = "postgresql"
    url      = env("DB_URL")
  }

  model User {
    id         Int           @id @default(autoincrement())
    userName   String        @map("user_name")
    password   String
    email      String        @unique
    createdAt  DateTime      @default(now()) @map("created_at")
    grade      String?       @default("null")
    education  String?       @default("null")
    tokens     UserToken[]
    tests      Test[]
    testQuestions TestQuestion[]
    testResults    TestResult[]   
  }    

  model UserToken {
    id        Int      @id @default(autoincrement()) @map("user_token_id")
    userId    Int      @map("fk_user")
    token     String?
    createdAt DateTime?
    updatedAt DateTime?
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  }

  model Test {
    id         Int      @id @default(autoincrement()) @map("test_id")
    userId     Int
    isCompleted Boolean @default(false) @map("iscompleted")
    user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    testQuestions TestQuestion[]
    testResult    TestResult?
    Question  Question[]
    
  }

  model Question {
    id            Int      @id @default(autoincrement())
    question      String
    options       String[]
    correctOption Int
    topic         String?  // Allow null values (remove default "null")
    subTopic      String?  // Allow null values (remove default "null")
    difficulty    Int
    Question_type String
    explanation   String?
    testId        Int     // Make it optional
    test          Test?    @relation(fields: [testId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    testQuestions TestQuestion[]
  }


  model TestQuestion {
    id            Int      @id @default(autoincrement())
    testId        Int
    userId        Int
    questionId    Int
    selectedOption Int?
    reviewStatus  Boolean?
    submitStatus  Boolean?
    timetaken     Float?
    isCorrect     Int      @default(0)
    test          Test     @relation(fields: [testId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    question      Question @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    user          User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    
  }


  model TestResult {
    id            Int      @id @default(autoincrement())
    testId        Int      @unique
    userId        Int
    score         Int
    totalQuestions Int
    correctAnswers Int
    percentage    Float
    createdAt     DateTime @default(now())

    test          Test     @relation(fields: [testId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    user          User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  }
